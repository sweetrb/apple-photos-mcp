node_modules/

# Build output is intentionally tracked so the marketplace plugin works
# without an npm install step (Claude Code does not run npm install on
# path-source plugins). Override the global ~/.gitignore entry.
# Only the bundled entrypoint is tracked; per-module tsc output (e.g. from
# `npm run dev`) stays ignored.
!build/
build/*
!build/index.js

*.js.map
*.d.ts.map
.env
.DS_Store
coverage/

# Python venv (+ the transient cross-process bootstrap lock)
# Match BOTH the real directory and a symlink named `venv`. The trailing-slash
# form matches directories only, so an isolated worktree that symlinks venv/ for
# dep reuse left the symlink UNIGNORED — a `git add -A` then committed it, and CI
# checked it out as a broken symlink that defeated setup.sh's `[ -d ]` guard
# (python -m venv then failed with [Errno 17] File exists).
venv
venv/
venv.setup.lock/
__pycache__/

# Vitest temp files
vitest.config.ts.timestamp-*

# npm package files
*.tgz
.claude/
.worktrees/
